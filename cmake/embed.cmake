# Generates a C++ source that embeds a binary file: rv_embed(<var> <input> <output>)
function(rv_embed var input output)
  file(READ "${input}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR size "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
  file(WRITE "${output}" "// generated from ${input}\n#include <cstddef>\nextern const unsigned char ${var}[] = {\n${bytes}\n};\nextern const std::size_t ${var}_size = ${size};\n")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
endfunction()
